{
  "expo": {
    "name": "GroupCoinApp",
    "slug": "groupcoin-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "dark",
    "scheme": "groupcoin",
    "platforms": [
      "ios",
      "android"
    ],
    "splash": {
      "image": "./assets/nobg.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.groupcoin.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/logo.png"
      },
      "package": "com.groupcoin.mobile",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "a2a9de89-30f2-4b6a-804e-2c409a08d776"
      },
      "apiUrl": "http://localhost:3000",
      "appEnv": "dev",
      "router": {}
    }
  }
}
